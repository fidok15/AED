# One TLS entry point for the full-portal deployment (docker-compose.aed-domain.yml).
# Caddy gets Let's Encrypt certificates for all four names; DNS of each must point at this server.
# Host names: AED_API_HOST, AED_ADMIN_HOST, AED_CMS_HOST (compose defaults: api./admin./cms.<AED_DOMAIN>).
# AED_SITE_SCHEME=http:// serves plain HTTP behind a TLS-terminating tunnel (docker-compose.aed-tunnel.yml).
#   <domain>        portal frontend (fork) + AED module, /api/aed -> aed-service, /api -> portal API
#   api.<domain>    portal API (resource files under /media, GET /aed-aggregated)
#   admin.<domain>  portal admin panel (Django)
#   cms.<domain>    portal CMS (Wagtail)
# Static files and media are served from the backend/ folders, as backend/docker/nginx does locally.
# Only the portal's public media folders are served (settings/base.py: RESOURCES_, IMAGES_, SHOWCASES_, ACADEMY_,
# NEWSLETTER_, LABORATORY_, DATASETS_ and DCAT_VOCABULARIES_MEDIA_ROOT). Everything else under /media - reports,
# meetings, to_be_removed, dga_temp, main_aed (working files), submission_staging, resources/waiting - is 403.
# Reports and meeting attachments need the portal's login check (X-Accel in 03-admin.conf.template), which this
# proxy does not replay. ponytail: /media/resources is public by path, as on the upstream API host
# (mcod/api.py serves MEDIA_ROOT); a draft's file is reachable if its path is known.

(public_media) {
	# Two disjoint matchers, so the order Caddy sorts the handle blocks in does not matter.
	@public_media {
		path /media/resources/* /media/images/* /media/showcases/* /media/academy/* /media/newsletter/* /media/lab_reports/* /media/datasets/* /media/dcat/* /media/original_images/*
		not path /media/resources/waiting/*
	}
	@private_media {
		path /media/*
		not {
			path /media/resources/* /media/images/* /media/showcases/* /media/academy/* /media/newsletter/* /media/lab_reports/* /media/datasets/* /media/dcat/* /media/original_images/*
			not path /media/resources/waiting/*
		}
	}
	handle @public_media {
		# Editors upload these files (the portal accepts HTML and SVG): never let one run as a page of this origin.
		header Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
		header X-Content-Type-Options nosniff
		uri strip_prefix /media
		root * /srv/media
		file_server
	}
	handle @private_media {
		respond 403
	}
}

{$AED_SITE_SCHEME}{$AED_DOMAIN} {
	encode gzip
	reverse_proxy aed-web:80
}

{$AED_SITE_SCHEME}{$AED_API_HOST} {
	encode gzip
	import public_media
	handle {
		reverse_proxy mcod-local-api:8000
	}
}

{$AED_SITE_SCHEME}{$AED_ADMIN_HOST} {
	encode gzip
	import public_media
	handle_path /static/* {
		root * /srv/statics
		file_server
	}
	# ponytail: the admin host's X-Accel publish check for /media/resources is skipped (public_media above).
	handle {
		reverse_proxy mcod-local-admin:8001
	}
}

{$AED_SITE_SCHEME}{$AED_CMS_HOST} {
	encode gzip
	import public_media
	redir / /admin/
	handle_path /static/* {
		root * /srv/statics
		file_server
	}
	handle {
		reverse_proxy mcod-local-cms:8002
	}
}
