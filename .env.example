# Copy to .env (not committed). Only AED_DOMAIN is needed for a public deployment.

# Domain without scheme, e.g. aed.example.pl. DNS must already point at this server.
AED_DOMAIN=

# Local port of the plain-HTTP frontend (also published in production; block it in the firewall if unwanted).
WEB_PORT=8080

# Password for the three demo accounts (ministerstwo@, pulsar@, serwis@aed.example). Empty = well-known demo
# passwords, which let anyone on the internet use the ministry panel. Applies only when the database is first
# created; to change it later remove the volume: docker compose down -v
AED_DEMO_PASSWORD=
