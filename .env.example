# Copy to .env (not committed). Only AED_DOMAIN is needed for a public deployment.

# Domain without scheme, e.g. aed.example.pl. DNS must already point at this server.
AED_DOMAIN=

# Local port of the plain-HTTP frontend. Local docker-compose.yml only: docker-compose.prod.yml does not publish it,
# so in production the frontend is reachable only through Caddy (HTTPS).
WEB_PORT=8080

# Password for the three demo accounts (ministerstwo@, pulsar@, serwis@aed.example). Empty = the well-known demo
# passwords from the README: anyone can then sign in to the prototype's ministry panel. This is the team's deliberate
# choice for the presentation; set a password for anything beyond the demo.
AED_DEMO_PASSWORD=
# Separate password for the ministry account only (empty = the same as AED_DEMO_PASSWORD).
AED_MINISTRY_PASSWORD=
# Passwords are set when the database is first created. To change them later: set the variables above,
# start once with AED_RESET_PASSWORDS=1 (new hashes, every session signed out), then set it back to 0.
AED_RESET_PASSWORDS=0

# 1 = fictional demo devices (marked DEMO, never exported). 0 = registry without demo devices.
AED_DEMO_SEED=1

# 1 = the converter offers "fill the position from the address" (addresses go to the GUGiK geocoding service, only
# when the user ticks the box). 0 = never; use it for a deployment without internet access.
AED_GEOKODOWANIE=1
