{
  "/api/aed": {
    "target": "http://localhost:8085",
    "secure": false,
    "logLevel": "warn",
    "changeOrigin": true
  },
  "/api/**": {
    "target": "http://localhost:8000/1.4/",
    "secure": false,
    "pathRewrite": {
      "^/api": ""
    },
    "logLevel": "warn",
    "changeOrigin": true
  },
  "/media": {
    "target": {
      "protocol": "https:",
      "host": "127.0.0.1",
      "port": 443,
      "servername": "api.mcod.local"
    },
    "headers": {
      "Host": "api.mcod.local"
    },
    "secure": false,
    "logLevel": "warn"
  },
  "/flags": {
    "target": "https://dane.gov.pl/",
    "secure": true,
    "logLevel": "warn",
    "changeOrigin": true
  },
  "/cms": {
    "target": "http://localhost:8002",
    "secure": false,
    "logLevel": "warn",
    "changeOrigin": true,
    "pathRewrite": {
      "^/cms": ""
    }
  },
  "/pn-apps": {
    "target": "http://localhost:8001",
    "secure": false,
    "logLevel": "warn",
    "changeOrigin": true,
    "ws": true
  }
}
